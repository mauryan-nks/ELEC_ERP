CI_ENVIRONMENT = development
app.baseURL = 'https://drmi.vismrit.tech/'
app.forceGlobalSecureRequests = false

# MySQL / MariaDB
database.default.hostname = 127.0.0.1
database.default.database = drmi_shop
database.default.username = drmi_shop
database.default.password = drmi_shop
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Shop defaults
shop.defaultStoreId = 1
shop.currency = INR
shop.timezone = Asia/Kolkata

# WhatsApp Web bridge (local-only Node service)
whatsapp.bridgeUrl = 'http://127.0.0.1:3099'
whatsapp.bridgeKey = 'CHANGE_THIS_TO_THE_SAME_LONG_RANDOM_SECRET_AS_CI'
